+static int GetMuxStream(sout_mux_t *p_mux)
+{
+    if(!p_mux->p_sys->b_draining)
+        return sout_MuxGetStream(p_mux, 2, NULL);
+    int chosen = -1;
+    vlc_tick_t earliest = 0;
+    for(int i = 0; i < p_mux->i_nb_inputs; ++i)
+    {
+        block_fifo_t *fifo = p_mux->pp_inputs[i]->p_fifo;
+        if(block_FifoCount(fifo) == 0)
+            continue;
+        vlc_tick_t dts = block_FifoShow(fifo)->i_dts;
+        if(chosen < 0 || dts < earliest)
+        {
+            chosen = i;
+            earliest = dts;
+        }
+    }
+    return chosen;
+}
