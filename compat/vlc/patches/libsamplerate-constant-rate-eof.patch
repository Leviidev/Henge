+/* Constant-rate EOF is a frame-count boundary. Accumulated fractional sample
+** positions can drift across that boundary and omit the final sinc evaluation.
+** Use consumed input/output counts; variable-ratio streams retain prior behavior.
+*/
+static int sinc_eof_count_reached (const SINC_FILTER *filter)
+{
+    double expected = (double)filter->total_input_frames * filter->fixed_ratio ;
+    double nearest = nearbyint(expected) ;
+    if (fabs(expected - nearest) <= 4 * DBL_EPSILON * MAX(expected, 1.0))
+        expected = nearest ;
+    uint64_t target = (uint64_t)floor(expected) ;
+    return filter->total_output_frames + filter->out_gen / filter->channels >= target ;
+}
 
 static int sinc_multichan_vari_process (SRC_PRIVATE *psrc, SRC_DATA *data) ;
 static int sinc_hex_vari_process (SRC_PRIVATE *psrc, SRC_DATA *data) ;
