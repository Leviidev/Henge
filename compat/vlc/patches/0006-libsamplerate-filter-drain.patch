+/* Preserve buffered PCM at EOF and stamp all output on one sample clock. */
+static block_t *Drain(filter_t *filter)
+{
+    srcfix_sys *sys = (srcfix_sys *)filter->p_sys;
+    if(sys->drained) return NULL;
+    sys->drained = true;
+    const size_t framesize = filter->fmt_out.audio.i_bytes_per_frame;
+    block_t *chain = NULL;
+    for(;;)
+    {
+        block_t *out = block_Alloc(4096 * framesize);
+        if(!out) break;
+        float empty_input = 0.0f;
+        SRC_DATA src = {0};
+        src.data_in = &empty_input; /* libsamplerate0.1.9 requires non-NULL even for zero frames. */
+        src.data_out = (float *)out->p_buffer;
+        src.output_frames = 4096;
+        src.src_ratio = (double)filter->fmt_out.audio.i_rate / filter->fmt_in.audio.i_rate;
+        src.end_of_input = 1;
+        int err = src_process(sys->state, &src);
+        if(err || !src.output_frames_gen)
+        {
+            block_Release(out);
+            if(err) msg_Err(filter, "cannot drain resampler: %s", src_strerror(err));
+            break;
+        }
+        out->i_buffer = src.output_frames_gen * framesize;
+        out->i_nb_samples = src.output_frames_gen;
+        out->i_pts = date_Get(&sys->date);
+        out->i_length = date_Increment(&sys->date, src.output_frames_gen) - out->i_pts;
+        block_ChainAppend(&chain, out);
+    }
+    return chain;
+}
+
+static void Flush(filter_t *filter)
+{
+    srcfix_sys *sys = (srcfix_sys *)filter->p_sys;
+    src_reset(sys->state);
+    date_Set(&sys->date, VLC_TICK_INVALID);
+    sys->drained = false;
+}
