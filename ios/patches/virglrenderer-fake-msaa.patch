+ * the guest gets one sample, which Chrome's GPU process refuses (ES 3.0 asks for 4). Unless
+ * VIRGL_NO_FAKE_MSAA is set, every format that can be rendered to is called multisample-capable instead, and
+ * vrend_resource_alloc_texture makes such resources single-sampled: drawing works, without antialiasing. */
+bool vrend_fake_msaa;
+
 void vrend_check_texture_multisample(struct vrend_format_table *table,
                                      bool enable_storage)
 {
    bool is_desktop_gl = epoxy_is_desktop_gl();
+   if (!is_desktop_gl && epoxy_gl_version() < 31 && !getenv("VIRGL_NO_FAKE_MSAA")) {
+      vrend_fake_msaa = true;
+      for (int i = 0; i < VIRGL_FORMAT_MAX_EXTENDED; i++)
+         if (table[i].internalformat != 0 &&
+             (table[i].bindings & (VIRGL_BIND_RENDER_TARGET | VIRGL_BIND_DEPTH_STENCIL)))
+            table[i].flags |= VIRGL_TEXTURE_CAN_MULTISAMPLE;
+      return;
+   }
    for (int i = 0; i < VIRGL_FORMAT_MAX_EXTENDED; i++) {
       bool function_available =
          (table[i].flags & VIRGL_TEXTURE_CAN_TEXTURE_STORAGE) ? enable_storage : is_desktop_gl;
