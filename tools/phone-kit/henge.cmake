# CMake's toolchain file for iPhone programs built in Henge: cmake -G Ninja -DCMAKE_TOOLCHAIN_FILE=$HENGE_TOOLS/henge.cmake
set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_OSX_SYSROOT "${CMAKE_CURRENT_LIST_DIR}/sdk/iPhoneOS.sdk")
set(CMAKE_OSX_DEPLOYMENT_TARGET 17.0 CACHE STRING "")
set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/bin/clang")
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/bin/clang++")
set(CMAKE_AR "${CMAKE_CURRENT_LIST_DIR}/bin/ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${CMAKE_CURRENT_LIST_DIR}/bin/ranlib" CACHE FILEPATH "")
set(CMAKE_MAKE_PROGRAM "${CMAKE_CURRENT_LIST_DIR}/bin/ninja" CACHE FILEPATH "")
set(Python3_EXECUTABLE "${CMAKE_CURRENT_LIST_DIR}/bin/python3" CACHE FILEPATH "")
set(CMAKE_MACOSX_BUNDLE OFF)
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
set(CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED NO)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
